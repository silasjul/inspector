{
  "name": "tsl-inspector",
  "version": "0.2.0",
  "description": "Leva's useControls over the three.js WebGPU Inspector, for React Three Fiber. Tweak TSL uniforms with no re-render and no recompile.",
  "type": "module",
  "license": "MIT",
  "author": "silasjul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silasjul/inspector.git"
  },
  "bugs": "https://github.com/silasjul/inspector/issues",
  "homepage": "https://github.com/silasjul/inspector#readme",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "prepare": "npm run build"
  },
  "keywords": [
    "three",
    "threejs",
    "tsl",
    "webgpu",
    "react-three-fiber",
    "r3f",
    "leva",
    "inspector",
    "gui"
  ],
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "react-dom": ">=19",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
